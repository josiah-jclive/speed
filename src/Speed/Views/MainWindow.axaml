<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Speed.ViewModels"
        xmlns:core="using:Speed.Core"
        xmlns:out="using:Speed.Output"
        xmlns:views="using:Speed.Views"
        xmlns:dev="using:Speed.Devices"
        x:Class="Speed.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="JSPEED"
        Icon="avares://JSPEED/Assets/Icons/state-ready.png"
        Width="1440" Height="900" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen">

  <Window.KeyBindings>
    <KeyBinding Gesture="F7" Command="{Binding ToggleArmCommand}" />
    <KeyBinding Gesture="F9" Command="{Binding RecordAllCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <Style Selector="Ellipse.link">
      <Setter Property="Fill" Value="{StaticResource Dim}" />
    </Style>
    <Style Selector="Ellipse.link.online">
      <Setter Property="Fill" Value="{StaticResource Green}" />
    </Style>
    <Style Selector="TextBlock.headline">
      <Setter Property="FontSize" Value="34" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="-0.6" />
    </Style>
    <Style Selector="TextBlock.headline.attention">
      <Setter Property="Foreground" Value="{StaticResource AmberText}" />
    </Style>
    <Style Selector="TextBlock.detail.attention">
      <Setter Property="Foreground" Value="{StaticResource AmberSub}" />
    </Style>
    <Style Selector="TextBlock.media.low">
      <Setter Property="Foreground" Value="{StaticResource AmberText}" />
    </Style>
    <Style Selector="Border.arm">
      <Setter Property="Background" Value="{StaticResource Panel}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    </Style>
    <Style Selector="Border.arm.armed">
      <Setter Property="Background" Value="#3A2C15" />
      <Setter Property="BorderBrush" Value="{StaticResource Amber}" />
    </Style>
    <Style Selector="TextBlock.recSub">
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>
    <!-- ON AIR block on encoder cards: the JSPEED lockup, red letters on white when live, outlined when not. -->
    <Style Selector="Border.airblock">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource Dim}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="9,0" />
      <Setter Property="Height" Value="30" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.airblock.on">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBlock.airword">
      <Setter Property="FontFamily" Value="{StaticResource BrandFont}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="Foreground" Value="{StaticResource Dim}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.airword.on">
      <Setter Property="Foreground" Value="{StaticResource Rec}" />
    </Style>
    <Style Selector="TextBlock.airword.on.warn">
      <Setter Property="Foreground" Value="{StaticResource Amber}" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="56,Auto,*">

    <!-- Title bar: JC Live, JSPEED, production name, output state, settings -->
    <Border Grid.Row="0" BorderBrush="#2A303A" BorderThickness="0,0,0,1" Padding="16,0,24,0">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Image Source="avares://JSPEED/Assets/jspeed-by-jc-live.png" Height="40" Margin="-4,0,0,0"
                 AutomationProperties.Name="JSPEED by JC LIVE" />
          <Border Width="1" Height="22" Background="{StaticResource Line2}"
                  IsVisible="{Binding TitleName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Text="{Binding TitleName}" Foreground="{StaticResource Dim}" FontSize="14" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Ellipse Width="8" Height="8" Classes="link" Classes.online="{Binding OutputHealthy}" />
            <TextBlock Text="{Binding OutputStatus}" Classes="muted" />
          </StackPanel>
          <Button Classes="icon" Width="36" Height="36" Click="OpenSettings"
                  AutomationProperties.Name="Settings">
            <Path Stroke="{StaticResource Text}" StrokeThickness="1.8" StrokeLineCap="Round" Width="18" Height="18" Stretch="Uniform"
                  Data="M4 7 H14 M18 7 H20 M4 17 H8 M12 17 H20 M18 7 A2 2 0 1 1 14 7 A2 2 0 1 1 18 7 M12 17 A2 2 0 1 1 8 17 A2 2 0 1 1 12 17" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Group status and the big controls -->
    <Border Grid.Row="1" Classes="strip"
            Classes.attention="{Binding IsAttentionState}" Classes.recording="{Binding IsRecordingState}">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4" VerticalAlignment="Center">
          <TextBlock Text="{Binding Status.Headline}" Classes="headline" Classes.attention="{Binding IsAttentionState}" />
          <TextBlock Text="{Binding Status.Detail}" Classes="muted detail" FontSize="14" Classes.attention="{Binding IsAttentionState}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
          <StackPanel IsVisible="{Binding TakeRunning}" VerticalAlignment="Center" Margin="0,0,10,0">
            <TextBlock Text="Take length" Classes="muted" FontSize="12" HorizontalAlignment="Right" />
            <TextBlock Text="{Binding TakeLengthText}" Classes="mono" FontSize="26" HorizontalAlignment="Right" />
          </StackPanel>
          <Border Classes="arm" Classes.armed="{Binding Armed}" BorderThickness="1" CornerRadius="12" Height="64" Padding="18,0"
                  IsVisible="{Binding RequireArm}">
            <CheckBox IsChecked="{Binding Armed}" VerticalAlignment="Center">
              <StackPanel Margin="4,0,0,0">
                <TextBlock Text="Arm record" FontWeight="SemiBold" FontSize="15" />
                <TextBlock Text="F7" Classes="muted" FontSize="12" />
              </StackPanel>
            </CheckBox>
          </Border>
          <Button Classes="big record" Command="{Binding RecordAllCommand}" IsEnabled="{Binding RecordAllEnabled}"
                  AutomationProperties.Name="Record all">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Ellipse Width="16" Height="16" Fill="White" VerticalAlignment="Center" />
              <TextBlock Text="Record all" VerticalAlignment="Center" />
              <TextBlock Text="F9" FontSize="12" FontWeight="Medium" Opacity="0.85" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <!-- Stop all is press and hold, so a stray click can't end a take. Set up in code-behind. -->
          <views:HoldButton x:Name="StopHold" Height="64" Width="250" CornerRadius="12" BorderThickness="1" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="*,400" Margin="24" ColumnSpacing="24">

      <!-- Encoders, then recorders -->
      <Grid RowDefinitions="Auto,Auto,*">
        <StackPanel Spacing="14" Margin="0,0,0,10" IsVisible="{Binding HasEncoders}">
          <TextBlock Text="Encoders" Classes="h2" />
          <ItemsControl ItemsSource="{Binding Encoders}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="dev:StreamingEncoder">
                <Border Classes="recorder" Margin="0,0,14,14"
                        Classes.recording="{Binding IsOnAir}" Classes.failed="{Binding IsWarning}">
                  <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="3">
                        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding DetailText}" Classes="muted" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Top" Margin="0,4,0,0">
                        <Ellipse Width="7" Height="7" Classes="link" Classes.online="{Binding IsOnline}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LinkText}" Classes="muted" />
                      </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="14">
                      <Border Classes="airblock" Classes.on="{Binding IsLive}">
                        <TextBlock Text="{Binding AirWord}" Classes="airword" Classes.on="{Binding IsLive}"
                                   Classes.warn="{Binding IsWarning}" />
                      </Border>
                      <TextBlock Text="{Binding StreamName}" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Grid Grid.Row="2" ColumnDefinitions="*,*,*">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Duration" Classes="muted" />
                        <TextBlock Text="{Binding DurationText}" Classes="mono" FontSize="20" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="Bitrate" Classes="muted" />
                        <TextBlock Text="{Binding BitrateText}" FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Spacing="2">
                        <TextBlock Text="Cache" Classes="muted" />
                        <TextBlock Text="{Binding CacheText}" FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0" />
                      </StackPanel>
                    </Grid>

                    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                      <TextBlock Text="{Binding PlatformText}" Classes="muted" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" />
                      <Button Grid.Column="1" Classes="icon" ToolTip.Tip="More" AutomationProperties.Name="More encoder actions"
                              Tag="{Binding}" Click="ShowEncoderMore">
                        <StackPanel Orientation="Horizontal" Spacing="3">
                          <Ellipse Width="4" Height="4" Fill="{StaticResource Text}" />
                          <Ellipse Width="4" Height="4" Fill="{StaticResource Text}" />
                          <Ellipse Width="4" Height="4" Fill="{StaticResource Text}" />
                        </StackPanel>
                      </Button>
                    </Grid>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="0,0,0,14">
          <TextBlock Text="Recorders" Classes="h2" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="quiet" Click="AddEncoder">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Stroke="{StaticResource Text}" StrokeThickness="2" StrokeLineCap="Round" Width="12" Height="12" Stretch="Uniform"
                    Data="M12 5 V19 M5 12 H19" VerticalAlignment="Center" />
              <TextBlock Text="Add encoder" FontSize="13" />
            </StackPanel>
          </Button>
          <Button Grid.Column="2" Classes="quiet" Click="AddRecorder">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Stroke="{StaticResource Text}" StrokeThickness="2" StrokeLineCap="Round" Width="12" Height="12" Stretch="Uniform"
                    Data="M12 5 V19 M5 12 H19" VerticalAlignment="Center" />
              <TextBlock Text="Add recorder" FontSize="13" />
            </StackPanel>
          </Button>
        </Grid>

        <Border Grid.Row="2" Classes="card" Padding="32" IsVisible="{Binding HasNoRecorders}" VerticalAlignment="Top">
          <StackPanel Spacing="10">
            <TextBlock Text="No recorders yet" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Classes="muted" FontSize="14" TextWrapping="Wrap"
                       Text="Add each Shogun, HyperDeck and Ki Pro you want JSPEED to roll. Shoguns connect through a USB to RS-422 adapter; HyperDecks and Ki Pros by IP address." />
            <Button Classes="primary" Content="Add recorder" Click="AddRecorder" HorizontalAlignment="Left" Margin="0,8,0,0" />
          </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" IsVisible="{Binding !HasNoRecorders}" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Recorders}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="core:Recorder">
                <Border Classes="recorder" Margin="0,0,14,14"
                        Classes.recording="{Binding IsRecording}" Classes.failed="{Binding FailedToStart}">
                  <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="3">
                        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}" Classes="muted" />
                        <TextBlock Text="{Binding Warning}" Foreground="{StaticResource AmberText}" FontSize="13"
                                   IsVisible="{Binding Warning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Top" Margin="0,4,0,0">
                        <Ellipse Width="7" Height="7" Classes="link" Classes.online="{Binding IsOnline}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LinkText}" Classes="muted" />
                      </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="1" Text="{Binding TimecodeText}" Classes="mono" FontSize="46" LetterSpacing="-0.9" />

                    <StackPanel Grid.Row="2" Spacing="7">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding MediaLabel}" Classes="muted" />
                        <TextBlock Grid.Column="1" Text="{Binding MediaText}" FontSize="13" FontWeight="Medium"
                                   Classes="media" Classes.low="{Binding MediaLow}" />
                      </Grid>
                      <ProgressBar Classes="media" Classes.low="{Binding MediaLow}" Value="{Binding MediaBarValue}"
                                   IsVisible="{Binding HasMediaBar}" />
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" Margin="0,2,0,0">
                        <TextBlock Text="Format" Classes="muted" />
                        <TextBlock Grid.Column="1" Text="{Binding FormatText}" FontSize="13" FontWeight="Medium"
                                   HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </StackPanel>

                    <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto">
                      <Border Classes="pill" Classes.recording="{Binding IsRecording}" Classes.failed="{Binding FailedToStart}"
                              VerticalAlignment="Center">
                        <TextBlock Text="{Binding StateText}" />
                      </Border>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <CheckBox IsChecked="{Binding IncludeInGroup}" Content="In group" FontSize="13" Margin="0,0,6,0" />
                        <Button Classes="icon"
                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RecordOneCommand}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding $parent[Window].((vm:MainViewModel)DataContext).RecordAllEnabled}"
                                ToolTip.Tip="Record this recorder" AutomationProperties.Name="Record">
                          <Ellipse Width="12" Height="12" Fill="{StaticResource Rec}" />
                        </Button>
                        <Button Classes="icon"
                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).StopOneCommand}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="Stop this recorder" AutomationProperties.Name="Stop">
                          <Rectangle Width="11" Height="11" RadiusX="2" RadiusY="2" Fill="{StaticResource Text}" />
                        </Button>
                        <Button Classes="icon" ToolTip.Tip="More" AutomationProperties.Name="More actions"
                                Tag="{Binding}" Click="ShowMore">
                          <StackPanel Orientation="Horizontal" Spacing="3">
                            <Ellipse Width="4" Height="4" Fill="{StaticResource Text}" />
                            <Ellipse Width="4" Height="4" Fill="{StaticResource Text}" />
                            <Ellipse Width="4" Height="4" Fill="{StaticResource Text}" />
                          </StackPanel>
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>

      <!-- Program output and activity -->
      <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="14">
        <TextBlock Text="Program output" Classes="h2" Height="34" VerticalAlignment="Center" Padding="0,8,0,0" />
        <Border Grid.Row="1" Classes="card" Padding="16">
          <StackPanel Spacing="14">
            <Border CornerRadius="8" ClipToBounds="True" Background="Black">
              <Viewbox Stretch="Uniform">
                <out:ProgramOutputView x:Name="Preview" Width="1920" Height="1080" />
              </Viewbox>
            </Border>
            <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
              <TextBlock Text="Device" Classes="muted" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SelectedDevice}"
                        HorizontalAlignment="Stretch" IsEnabled="{Binding !OutputRunning}" PlaceholderText="No device found" />
              <TextBlock Grid.Row="1" Text="Format" Classes="muted" VerticalAlignment="Center" />
              <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding OutputModes}" SelectedItem="{Binding SelectedMode}"
                        HorizontalAlignment="Stretch" IsEnabled="{Binding !OutputRunning}" />
              <TextBlock Grid.Row="2" Text="Status" Classes="muted" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding OutputStatus}" FontSize="13" TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <Button Classes="quiet" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Command="{Binding ToggleOutputCommand}">
                <Panel>
                  <TextBlock Text="Start output" IsVisible="{Binding !OutputRunning}" />
                  <TextBlock Text="Stop output" IsVisible="{Binding OutputRunning}" />
                </Panel>
              </Button>
              <Button Grid.Column="1" Classes="quiet" Content="Rescan" Command="{Binding RefreshOutputDevicesCommand}"
                      IsEnabled="{Binding !OutputRunning}" ToolTip.Tip="Look for UltraStudio and DeckLink devices again" />
            </Grid>
          </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Text="Activity" Classes="h2" Margin="0,6,0,0" />
        <Border Grid.Row="3" Classes="card" Padding="16,12">
          <ScrollViewer x:Name="LogScroll" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Log}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="core:LogEntry">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,0,0,8">
                    <TextBlock Text="{Binding TimeText}" Classes="mono" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,1,0,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Message}" FontSize="13" TextWrapping="Wrap"
                               Classes="msg" Classes.warn="{Binding IsWarning}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
              <ItemsControl.Styles>
                <Style Selector="TextBlock.msg">
                  <Setter Property="Foreground" Value="{StaticResource Text2}" />
                </Style>
                <Style Selector="TextBlock.msg.warn">
                  <Setter Property="Foreground" Value="{StaticResource AmberText}" />
                </Style>
              </ItemsControl.Styles>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
